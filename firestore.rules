rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: is the user authenticated?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function: does the user own this document?
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User documents: only the authenticated owner can read/write their data
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      // Portfolio history subcollection: only the authenticated owner can read/write their snapshot data
      match /portfolio_history/{snapshotId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /users/{userId}/dividends/{entryId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/tax_events/{eventId} {
      allow read, write: if isOwner(userId);
    }

    // Transaction subcollection: migrated from array field for scalability
    match /users/{userId}/transactions/{txnId} {
      allow read, write: if isOwner(userId);
      allow create: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}
}