{
  "name": "balancr",
  "private": true,
  "version": "2026.16.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "prebuild": "node scripts/generate-version.js",
    "build": "npm run build --workspace apps/web",
    "lint": "NODE_OPTIONS='--require ./scripts/ts-eslint-resolve.cjs' eslint .",
    "preview": "npm run preview --workspace apps/web",
    "test": "npm run test --workspace apps/web",
    "test:watch": "npm run test:watch --workspace apps/web",
    "postinstall": "node scripts/fix-tsc-bin.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "standard-version": "^9.5.0",
    "typescript-eslint": "^8.59.3"
  },
  "standard-version": {
    "header": "",
    "tagPrefix": "v",
    "releaseCommitMessageFormat": "chore(release): {{currentTag}}"
  }
}
